@using Shared.Components.DiagramBoard
@using Shared.Components.DiagramBoard.DiagramCanvas
<MudThemeProvider  />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudStack Spacing="0" Style="height:100vh;">
    <MudStack Spacing="0" Style="position:sticky; top:0; z-index:10; background:white;">
        <DiagramToolbar @ref="diagramToolbar" 
                        OnAutoAdjustNodePosition="HandleDiagramNodePositioning"
                        OnZoomIn="HandleZoomIn"
                        OnZoomOut="HandleZoomOut"
                        OnZoomReset="HandleZoomReset"
                        OnFitToScreen="HandleFitToScreen"
                        ZoomLevel="@GetCurrentZoomLevel()" />
    </MudStack>
    <MudPaper Class="d-flex align-center" Style="
        overflow:hidden;
        background:#e0e0e0;
        flex:1;
        flex-direction:row;
        flex-wrap:nowrap;
        justify-content:flex-start;
        gap:0px;
        padding:0px;">
        <DiagramCanvasView @ref="diagramCanvasView"/>
    </MudPaper>
</MudStack>

