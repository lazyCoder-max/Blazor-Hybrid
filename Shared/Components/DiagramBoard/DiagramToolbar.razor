<MudToolBar WrapContent="true" Gutters="true">
    
    <MudTooltip Text="Save Mapping">
        <MudIconButton Size="Size.Medium" Icon="@Icons.Material.Filled.Save" Color="Color.Inherit" OnClick="@(()=>OnMappingSaved.InvokeAsync())"></MudIconButton>
    </MudTooltip>
    <MudTooltip Text="Render Mapping">
        <MudIconButton Size="Size.Medium" Icon="@Icons.Material.Filled.LocalPrintshop" Color="Color.Inherit" OnClick="@(()=>OnRenderMapping.InvokeAsync())"></MudIconButton>
    </MudTooltip>
    <MudTooltip Text="Auto adjust node position">
        <MudIconButton Size="Size.Medium" Icon="@moveIcon" Color="Color.Inherit" OnClick="@(()=>OnAutoAdjustNodePosition.InvokeAsync())"></MudIconButton>
    </MudTooltip>
    <MudTooltip Text="Auto link">
        <MudIconButton Size="Size.Medium" Icon="@Icons.Material.Filled.Link" Color="Color.Inherit" OnClick="@(() => OnAutoLink.InvokeAsync())"></MudIconButton>
    </MudTooltip>
    <MudTooltip Text="Reset Mapping">
        <MudIconButton Size="Size.Medium" Icon="@resetIcon" Color="Color.Inherit" OnClick="@(()=>OnMappingReset.InvokeAsync())"></MudIconButton>
    </MudTooltip>
    <MudTooltip Text="Undo">
        <MudIconButton Size="Size.Medium" Icon="@Icons.Material.Filled.Undo" Color="Color.Inherit" OnClick="@(()=>OnUndo.InvokeAsync())"></MudIconButton>
    </MudTooltip>
    <MudTooltip Text="Redo">
        <MudIconButton Size="Size.Medium" Icon="@Icons.Material.Filled.Redo" Color="Color.Inherit" OnClick="@(()=>OnRedo.InvokeAsync())"></MudIconButton>
    </MudTooltip>
    
    <MudDivider Vertical="true" FlexItem="true" />
    
    @* Zoom Controls *@
    <MudTooltip Text="Zoom Out">
        <MudIconButton Size="Size.Medium" Icon="@Icons.Material.Filled.ZoomOut" Color="Color.Inherit" OnClick="@(()=>OnZoomOut.InvokeAsync())"></MudIconButton>
    </MudTooltip>
    <MudText Typo="Typo.body2" Style="min-width:60px;text-align:center;">@($"{ZoomLevel:P0}")</MudText>
    <MudTooltip Text="Zoom In">
        <MudIconButton Size="Size.Medium" Icon="@Icons.Material.Filled.ZoomIn" Color="Color.Inherit" OnClick="@(()=>OnZoomIn.InvokeAsync())"></MudIconButton>
    </MudTooltip>
    <MudTooltip Text="Reset Zoom">
        <MudIconButton Size="Size.Medium" Icon="@Icons.Material.Filled.CenterFocusWeak" Color="Color.Inherit" OnClick="@(()=>OnZoomReset.InvokeAsync())"></MudIconButton>
    </MudTooltip>
    <MudTooltip Text="Fit to Screen">
        <MudIconButton Size="Size.Medium" Icon="@Icons.Material.Filled.FitScreen" Color="Color.Inherit" OnClick="@(()=>OnFitToScreen.InvokeAsync())"></MudIconButton>
    </MudTooltip>
    
</MudToolBar>
